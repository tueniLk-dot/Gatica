<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.urzua_benjamin.control.UsuarioController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

      <HBox prefHeight="100.0" prefWidth="200.0" spacing="20">

            <TextField fx:id="txtNombre" prefHeight="60" prefWidth="120" promptText="Nombre" />
            <TextField fx:id="txtEdad" prefHeight="60" prefWidth="120" promptText="Edad" />


              <Button fx:id="btnActualizar" text="Actualizar" onAction="#handleActualizar" disable="true"/>
                 <Button fx:id="btnCont" onAction="#handleContinuacion" prefHeight="10.0" prefWidth="200.0" text="Continuar" />
                <Button fx:id="btnEliminar" onAction="#handleEliminar" prefHeight="10.0" prefWidth="200.0" text="Eliminar" disable="true" />
      </HBox>
    <TextField fx:id="txtAprovacion" prefWidth="180" text="Has ingresado! " />
    <TableView fx:id="tableUsuario" onMouseClicked="#handleSelectTable">
       <columns>
           <TableColumn fx:id="colId" text="ID" />
           <TableColumn fx:id="colNombre" text="Nombre" />
           <TableColumn fx:id="colEdad" text="Edad" />
       </columns>
    </TableView>
</VBox>
