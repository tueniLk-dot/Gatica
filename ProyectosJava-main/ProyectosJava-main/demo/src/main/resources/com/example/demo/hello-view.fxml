
<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment='CENTER' spacing='12.0'
      xmlns='http://javafx.com/javafx/22'
      xmlns:fx='http://javafx.com/fxml/1'
      fx:controller='com.example.ejerciciojavafx.HelloController'>
    <padding>
        <Insets top='20' right='20' bottom='20' left='20'/>
    </padding>

    <Label text='Registro básico de usuario'
           style='-fx-font-size: 22px; -fx-font-weight: bold;'/>

    <Label text='Complete los siguientes datos'/>

    <TextField promptText='Ingrese su nombre' maxWidth='240'/>

    <CheckBox text='Acepto continuar con el ejercicio'/>
    <TextField fx:id='txtNombre' promptText='Ingrese su nombre' maxWidth='240'/>
    <CheckBox fx:id='chkAcepto' text='Acepto continuar con el ejercicio'/>
    <HBox alignment='CENTER' spacing='10.0'>
        <Button text='Guardar' onAction='#onGuardar'/>
        <Button text='Limpiar' onAction='#onLimpiar'/>
    </HBox>
    fx:controller="com.example.demo.Controller.HelloController"
</VBox>
