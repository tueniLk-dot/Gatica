<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.benja.control.UsuarioController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

   <HBox prefHeight="500.0" prefWidth="800.0">
         <TextField fx:id="txtNombre" promptText="Nombre" />
         <TextField fx:id="txtEdad" promptText="Edad" />
          <Button  onAction="#handleIngresar" prefWidth="80.0" text="Ingresar" />
       <Button fx:id="btnActualizar" text="Actualizar" onAction="#handleActualizar" prefWidth="80.0" disable="true"/>
       <Button fx:id="btnLimpiar" text="Limpiar" onAction="#handleLimpiar" prefWidth="80.0"/>
      <Button fx:id="btnEiminar" onAction="#handleEliminar" text="Eliminar" disable="true" />
    </HBox>
    <TextField fx:id="txtIngress" prefWidth="200" promptText="Ingreso: " disable="true"/>
    <TableView fx:id="tableUsuarios" onMouseClicked="#handleSelectTable">
        <columns>
            <TableColumn fx:id="idCol" text="ID" />
            <TableColumn  fx:id="columnaHombre" text="Nombre" />
            <TableColumn  fx:id="colEdad" text="Edad"/>
        </columns>
    </TableView>
</VBox>
